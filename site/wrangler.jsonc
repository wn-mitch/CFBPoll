{
	"name": "cfbpoll",
	"compatibility_date": "2026-10-01",
	// The worker only handles /logo/*; every other path is a static asset.
	"main": "worker.ts",
	"assets": { "directory": "build", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/logo/*"] },
	// custom_domain lets wrangler create the DNS record and certificate itself.
	"routes": [{ "pattern": "cfb.alpacasoft.dev", "custom_domain": true }]
}
